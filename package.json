{
  "name": "@dedel.alex/keycloak-admin-client-cjs",
  "version": "26.2.0",
  "description": "Keycloak Admin Client compiled in CommonJS.",
  "keywords": [
    "keycloak-admin-client",
    "CommonJS",
    "AdonisJS",
    "NestJS"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "esbuild dist/index.d.ts --platform=node --bundle --format=cjs --outfile=dist/index.js",
    "prepublishOnly": "npm run build",
    "prepare": "husky || true",
    "release": "commit-and-tag-version -s",
    "sync": "node scripts/sync.mjs",
    "sync:dry": "node scripts/sync.mjs --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aDedel/keycloak-admin-client-cjs.git"
  },
  "author": "aDedel",
  "license": "MIT",
  "dependencies": {
    "@keycloak/keycloak-admin-client": "26.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commit-and-tag-version": "^13.3.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7"
  },
  "files": [
    "dist/**/*"
  ]
}
